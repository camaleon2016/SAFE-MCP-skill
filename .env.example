# ── SAFE-MCP Skill Configuration ────────────────────────────────────
# Copy to .env and adjust values as needed.

# Server
HOST=127.0.0.1
PORT=3001          # MCP HTTP transport
# REST_PORT=3002   # OpenAPI REST server (src/openapi/serve.ts)

# Governance - Access Control
# SAFE_MCP_REQUIRE_API_KEY=true
# SAFE_MCP_API_KEYS=key1,key2
# SAFE_MCP_REQUIRE_IP_ALLOWLIST=false
# SAFE_MCP_IP_ALLOWLIST=127.0.0.1,::1

# Governance - Logging
# LOG_LEVEL=info              # debug | info | warn | error
# LOG_DIR=./logs
# LOG_TO_FILE=true
# LOG_TO_STDERR=true
